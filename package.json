{
  "name": "baytna-store-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack Store-owner portal for the Baytna home-business marketplace.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate:postgres": "node --env-file-if-exists=.env server/database/migrate-postgres-cli.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "pg": "^8.22.0"
  }
}
