# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8000

# Data
# Use exactly one database setting. SQLite remains the local-development default.
BAYTNA_DATABASE_PATH=./data/baytna.sqlite
# BAYTNA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# BAYTNA_DATABASE_CA_PATH=/absolute/path/to/prod-supabase.cer
# BAYTNA_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/postgres

# Supabase Storage (use the same project as BAYTNA_DATABASE_URL).
# The bucket must already exist and must be private.
# BAYTNA_SUPABASE_URL=https://PROJECT_REF.supabase.co
# BAYTNA_SUPABASE_SECRET_KEY=sb_secret_replace-with-a-server-only-key
# BAYTNA_SUPABASE_DOCUMENTS_BUCKET=store-documents

# Use at least 32 random characters. Never use this example value in production.
BAYTNA_SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
